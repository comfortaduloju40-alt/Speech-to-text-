# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# OpenAI API Key (for Whisper transcription)
OPENAI_API_KEY=your_openai_api_key_here

# Webhook settings (leave WEBHOOK_URL empty to use polling mode)
WEBHOOK_URL=https://your-railway-app.up.railway.app
WEBHOOK_SECRET=your_random_secret_string_here

# Port (Railway sets this automatically — do not change for production)
PORT=8000

# Optional tuning
MAX_FILE_SIZE_MB=25
RATE_LIMIT_MESSAGES=5
RATE_LIMIT_WINDOW_SECONDS=60
